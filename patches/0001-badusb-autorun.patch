diff --git a/main/managers/badusb_manager.c b/main/managers/badusb_manager.c
index a3120aa..93df538 100644
--- a/main/managers/badusb_manager.c
+++ b/main/managers/badusb_manager.c
@@ -999,6 +999,40 @@ esp_err_t badusb_manager_execute_buffer(char *buf, size_t len) {
     return ESP_OK;
 }
 
+esp_err_t badusb_manager_autorun(void) {
+#if defined(CONFIG_BADUSB_AUTORUN) && CONFIG_BADUSB_AUTORUN
+    const char *command = CONFIG_BADUSB_AUTORUN_COMMAND;
+    if (!command || command[0] == '\0') {
+        glog("BadUSB: Autorun command is empty\n");
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    char script[512];
+    int len = snprintf(script, sizeof(script),
+                       "DELAY 3000\n"
+                       "GUI r\n"
+                       "DELAY 500\n"
+                       "CTRL SPACE\n"
+                       "DELAY 300\n"
+                       "STRING %s\n"
+                       "DELAY 200\n"
+                       "ENTER\n",
+                       command);
+    if (len <= 0 || len >= (int)sizeof(script)) {
+        glog("BadUSB: Autorun command too long\n");
+        return ESP_ERR_INVALID_SIZE;
+    }
+
+    char *buf = strdup(script);
+    if (!buf) return ESP_ERR_NO_MEM;
+
+    glog("BadUSB: Autorun starting\n");
+    return badusb_manager_execute_buffer(buf, (size_t)len);
+#else
+    return ESP_ERR_NOT_SUPPORTED;
+#endif
+}
